{
  "expo": {
    "name": "Social Saver Pro",
    "slug": "social-saver-pro",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "scheme": "socialsaver",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#050816"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Social Saver Pro needs photo library access to save downloaded videos.",
        "NSPhotoLibraryAddUsageDescription": "Social Saver Pro saves downloaded videos to your media library."
      }
    },
    "android": {
      "package": "com.socialsaver.pro",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#050816"
      },
      "permissions": [
        "INTERNET",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Social Saver Pro to access your media library.",
          "savePhotosPermission": "Allow Social Saver Pro to save downloaded media."
        }
      ],
      "expo-splash-screen"
    ]
  }
}
